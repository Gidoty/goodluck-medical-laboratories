DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — generate a real secret for production: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed / demo credentials (only used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@goodluckmedicallabs.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_PATIENT_EMAIL="patient@example.com"
SEED_PATIENT_PASSWORD="Patient123!"

# Optional: SMTP for email notifications (leave blank to disable emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Goodluck Medical Laboratories <no-reply@goodluckmedicallabs.com>"
NOTIFY_EMAIL="goodluckmedicallaboratories@gmail.com"
